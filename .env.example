# Copy to .env (chmod 600). Never commit .env.
# Management key: only for `brain keys provision`, remove afterwards.
OPENROUTER_MANAGEMENT_KEY=
# One key per profile, created by `brain keys provision` (daily limits from config/profiles.yaml)
OPENROUTER_KEY_DEV=
OPENROUTER_KEY_AGO=
OPENROUTER_KEY_BENCHMARK=
OPENROUTER_KEY_ASSISTANT=
OPENROUTER_KEY_CAR=
# Local SQLite for usage snapshots and benchmark runs
BRAIN_DB=data/brain.db
# repo dir, so `brain` works from any folder
BRAIN_HOME=
