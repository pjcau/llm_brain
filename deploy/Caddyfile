# /etc/caddy/Caddyfile — replace the host with your subdomain, or use the
# sslip.io form (brain.<ip-with-dashes>.sslip.io) without owning a domain.
# The proxy routes go straight to brain, which checks the client key itself;
# the board stays behind basic auth:
#   caddy hash-password --plaintext '<password>'  → paste the hash below.
brain.1-2-3-4.sslip.io {
    encode zstd gzip
    @open path /health /api/hello /v1/*
    handle @open {
        reverse_proxy 127.0.0.1:8080 {
            flush_interval -1   # SSE: never buffer the streamed replies
        }
    }
    handle {
        basic_auth {
            pjonny <bcrypt-hash>
        }
        reverse_proxy 127.0.0.1:8080
    }
}
