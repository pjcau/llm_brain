# /etc/systemd/system/brain.service — the proxy (/v1/*) and the board.
# Secrets from /opt/llm_brain/.env (mode 0600, owner brain). Binds to
# localhost only; Caddy terminates TLS in front.
[Unit]
Description=llm_brain
After=network-online.target
Wants=network-online.target

[Service]
User=brain
Group=brain
WorkingDirectory=/opt/llm_brain
EnvironmentFile=/opt/llm_brain/.env
Environment=BRAIN_HOME=/opt/llm_brain
Environment=BRAIN_DB=/opt/llm_brain/data/brain.db
ExecStart=/opt/llm_brain/brain serve --bind 127.0.0.1:8080 --refresh 600
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/llm_brain/data

[Install]
WantedBy=multi-user.target
